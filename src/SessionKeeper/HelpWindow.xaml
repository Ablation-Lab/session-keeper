<Window x:Class="SessionKeeper.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="SessionKeeper help" Width="740" Height="500" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12,10,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="SectionList" Style="{StaticResource RowList}" SelectionChanged="SectionList_SelectionChanged"
                 AutomationProperties.Name="Help topics">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer x:Name="BodyScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="Body" Margin="0,0,8,0"/>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Full details: README.md in the SessionKeeper repository."/>
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
