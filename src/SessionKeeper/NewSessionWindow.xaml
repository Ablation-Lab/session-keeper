<Window x:Class="SessionKeeper.NewSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="New session" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=FolderBox}">
    <StackPanel Margin="16,14,16,16">
        <TextBlock Text="Project folder" FontWeight="SemiBold"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" AutomationProperties.Name="Project folder" TextChanged="FolderBox_TextChanged"/>
            <Button Grid.Column="1" Content="Browse…" Click="Browse_Click"/>
        </Grid>

        <TextBlock Text="Recent project folders" Style="{StaticResource MutedText}" Margin="0,12,0,4"/>
        <Grid>
            <ListBox x:Name="RecentFolders" Style="{StaticResource RowList}" MaxHeight="190" MinHeight="60"
                     SelectionChanged="RecentFolders_SelectionChanged" MouseDoubleClick="RecentFolders_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Path}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoRecentText" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" Text="No recent project folders. Use Browse… to pick one."/>
        </Grid>

        <TextBlock Text="Name (optional)" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="80" AutomationProperties.Name="Session name"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Shown as the window or tab title, and as the session's name in SessionKeeper once it appears under Current."/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start" IsDefault="True" Click="Start_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
