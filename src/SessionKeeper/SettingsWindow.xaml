<Window x:Class="SessionKeeper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <StackPanel Margin="16,14,16,16">
        <TextBlock Text="Open sessions in" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,6"
                   Text="Used by Open, Reopen selected and Restore."/>
        <RadioButton x:Name="OpenInPowerShell" GroupName="openIn" Content="PowerShell window" Checked="OpenIn_Checked"/>
        <RadioButton x:Name="OpenInTerminal" GroupName="openIn" Content="Windows Terminal tab" Margin="0,6,0,0" Checked="OpenIn_Checked"/>
        <TextBlock x:Name="TerminalMissingText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="21,3,0,0"
                   Visibility="Collapsed" Text="Windows Terminal isn't installed."/>

        <Border Height="1" Background="{StaticResource Border}" Margin="0,14,0,12"/>
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="21,3,0,0"
                   Text="Opens in the system tray when you sign in. Click the tray icon to show the window."/>
        <TextBlock x:Name="StartupWarning" Foreground="{StaticResource Note}" FontSize="12" TextWrapping="Wrap" Margin="21,4,0,0"
                   Visibility="Collapsed"/>

        <CheckBox x:Name="StartMenu" Content="Start menu shortcut" Margin="0,14,0,0" Checked="StartMenu_Changed" Unchecked="StartMenu_Changed"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="21,3,0,0"
                   Text="Adds SessionKeeper to your Start menu (just for you; no admin rights needed)."/>

        <Border Height="1" Background="{StaticResource Border}" Margin="0,14,0,10"/>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
            <Run Text="Running from:"/>
            <LineBreak/>
            <Run x:Name="ExePathRun" Foreground="{StaticResource Text}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Both settings point at this copy of the app. If you move it, untick and tick them again. Command-line options: SessionKeeper.exe --help"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <!-- Initial focus goes here, not to a checkbox, so a stray Space can't change a startup setting. -->
        <Button x:Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
