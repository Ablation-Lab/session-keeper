<Window x:Class="SessionKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="SessionKeeper" Width="920" Height="540" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Shared bits of the row templates -->
        <Style x:Key="FolderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SecondaryLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>
        <Style x:Key="RowOpenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Open"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <!-- Right-click a row: Open, Rename (your own name for the session), Clear name. -->
        <ContextMenu x:Key="RowMenu" x:Shared="False" Opened="RowMenu_Opened">
            <MenuItem Header="Open" Click="MenuOpen_Click"/>
            <MenuItem Header="Rename…" InputGestureText="F2" Click="MenuRename_Click"/>
            <MenuItem Header="Clear name" Click="MenuClearName_Click"/>
        </ContextMenu>
        <!-- Double-click (or Enter) on a row does the same as its Open button. -->
        <Style x:Key="OpenableItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"/>
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mode tabs + status -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <RadioButton x:Name="TabCurrent" Style="{StaticResource TabButton}" Content="Current" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabRecent" Style="{StaticResource TabButton}" Content="Recent" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSnapshots" Style="{StaticResource TabButton}" Content="Snapshots" Checked="Tab_Checked"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Padding="6,2"
                    Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                    ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
        </DockPanel>

        <!-- ============================== CURRENT ============================== -->
        <Grid x:Name="PanelCurrent" Grid.Row="1">
            <ListBox x:Name="CurrentList" Style="{StaticResource RowList}" ItemContainerStyle="{StaticResource OpenableItem}"
                     PreviewKeyDown="SessionList_PreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MainLabel}" Style="{StaticResource FolderText}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Warn}" Visibility="{Binding MissingVisibility}">
                                            <TextBlock Text="folder missing" FontSize="11" Foreground="{StaticResource AccentText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" Style="{StaticResource SecondaryLabel}" MaxWidth="220"
                                               Visibility="{Binding SecondaryVisibility}" ToolTip="{Binding ProjectDir}"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource SummaryText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding AgoText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource RowOpenButton}" Click="Open_Click"
                                    IsEnabled="{Binding CanOpen}" ToolTip="{Binding OpenTooltip}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="CurrentEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed" Text="No Claude Code sessions are running."/>
        </Grid>

        <!-- ============================== RECENT ============================== -->
        <Grid x:Name="PanelRecent" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Window:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <RadioButton x:Name="Win24h" Style="{StaticResource SmallTabButton}" Content="24 hours" IsChecked="True" Checked="Window_Checked" GroupName="win"/>
                    <RadioButton x:Name="Win3d" Style="{StaticResource SmallTabButton}" Content="3 days" Checked="Window_Checked" GroupName="win"/>
                    <RadioButton x:Name="Win7d" Style="{StaticResource SmallTabButton}" Content="7 days" Checked="Window_Checked" GroupName="win"/>
                    <RadioButton x:Name="Win30d" Style="{StaticResource SmallTabButton}" Content="30 days" Checked="Window_Checked" GroupName="win"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource LinkButton}" Content="Select all from today" Click="SelectToday_Click"/>
                    <Button Style="{StaticResource LinkButton}" Content="Clear" Click="ClearSelection_Click"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="RecentList" Grid.Row="1" Style="{StaticResource RowList}" SelectionMode="Single"
                     ItemContainerStyle="{StaticResource OpenableItem}" PreviewKeyDown="SessionList_PreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MainLabel}" Style="{StaticResource FolderText}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Good}" Visibility="{Binding RunningVisibility}">
                                            <TextBlock Text="running" FontSize="11" Foreground="{StaticResource AccentText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Warn}" Visibility="{Binding MissingVisibility}">
                                            <TextBlock Text="folder missing" FontSize="11" Foreground="{StaticResource AccentText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" Style="{StaticResource SecondaryLabel}" MaxWidth="220"
                                               Visibility="{Binding SecondaryVisibility}" ToolTip="{Binding Info.ProjectDir}"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource SummaryText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ShortId}" Style="{StaticResource MonoText}" HorizontalAlignment="Right" Margin="0,3,0,0"
                                           ToolTip="{Binding Info.SessionId}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource RowOpenButton}" Click="Open_Click"
                                    IsEnabled="{Binding CanOpen}" ToolTip="{Binding OpenTooltip}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="RecentEmpty" Grid.Row="1" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" Text="No sessions in this window."/>
        </Grid>

        <!-- ============================== SNAPSHOTS ============================== -->
        <Grid x:Name="PanelSnapshots" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="SnapshotList" Style="{StaticResource RowList}" SelectionChanged="SnapshotList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding File.Path}" Background="Transparent">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource FolderText}"/>
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource SummaryText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SnapshotsEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="12" Visibility="Collapsed"
                           Text="No snapshots yet. Use &quot;Save snapshot…&quot; at the end of the day."/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="2,0,0,6">
                    <TextBlock x:Name="SnapshotTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text=" "/>
                    <TextBlock x:Name="SnapshotMeta" Style="{StaticResource MutedText}" Text=" "/>
                    <TextBlock x:Name="SnapshotNote" Foreground="{StaticResource Note}" FontStyle="Italic" FontSize="12"
                               TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <ListBox x:Name="SnapshotSessions" Grid.Row="1" Style="{StaticResource RowList}"
                         ItemContainerStyle="{StaticResource OpenableItem}" PreviewKeyDown="SessionList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel ToolTip="{Binding Tooltip}" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MainLabel}" Style="{StaticResource FolderText}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Good}" Visibility="{Binding RunningVisibility}">
                                            <TextBlock Text="running" FontSize="11" Foreground="{StaticResource AccentText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource Warn}" Visibility="{Binding MissingVisibility}">
                                            <TextBlock Text="folder missing" FontSize="11" Foreground="{StaticResource AccentText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" Style="{StaticResource SecondaryLabel}" MaxWidth="220"
                                               Visibility="{Binding SecondaryVisibility}" ToolTip="{Binding Session.ProjectDir}"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource SummaryText}"/>
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource Note}" FontStyle="Italic" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding NoteVisibility}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource RowOpenButton}" Click="Open_Click"
                                    IsEnabled="{Binding CanOpen}" ToolTip="{Binding OpenTooltip}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- ============================== BOTTOM BARS ============================== -->
        <Grid x:Name="BarCurrent" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- One line that trims as a whole, so it can never overlap the buttons. The app version and the
                 .NET runtime are separate runs with their own colour and tooltip. -->
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                <Run Text="Auto-refreshes every 10 s"/><Run x:Name="VersionRun" FontSize="11" Foreground="{StaticResource Faint}"/><Run
                     x:Name="RuntimeRun" FontSize="11" Foreground="{StaticResource Faint}"/>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="New session…" Click="NewSession_Click" ToolTip="Start a new Claude Code session in a project folder"/>
                <Button Content="Refresh" Click="RefreshCurrent_Click"/>
                <Button x:Name="SaveCurrentButton" Style="{StaticResource PrimaryButton}" Content="Save these as snapshot…" Click="SaveCurrent_Click"/>
            </StackPanel>
        </Grid>
        <DockPanel x:Name="BarRecent" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="RecentSelectionText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="New session…" Click="NewSession_Click" ToolTip="Start a new Claude Code session in a project folder"/>
                <Button Content="Refresh" Click="RefreshRecent_Click"/>
                <Button x:Name="SaveRecentButton" Content="Save selected as snapshot…" Click="SaveRecent_Click"/>
                <Button x:Name="ReopenButton" Style="{StaticResource PrimaryButton}" Content="Reopen selected" Click="Reopen_Click"/>
            </StackPanel>
        </DockPanel>
        <DockPanel x:Name="BarSnapshots" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Save snapshot…" Margin="0" Click="SaveSnapshot_Click"/>
                <Button Style="{StaticResource LinkButton}" Content="Open folder" Click="OpenSnapshotFolder_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="New session…" Click="NewSession_Click" ToolTip="Start a new Claude Code session in a project folder"/>
                <Button x:Name="RenameButton" Content="Rename…" Click="RenameSnapshot_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="DeleteSnapshot_Click"/>
                <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="Restore" Click="RestoreSnapshot_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
