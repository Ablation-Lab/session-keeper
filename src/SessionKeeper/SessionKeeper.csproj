<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (System.Windows.Forms.NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SessionKeeper</AssemblyName>
    <RootNamespace>SessionKeeper</RootNamespace>
    <!-- Custom Main: command-line options run without starting the UI. -->
    <StartupObject>SessionKeeper.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>SessionKeeper</Product>
    <Description>See, save and reopen Claude Code sessions.</Description>
    <!-- Reading another process's working directory relies on 64-bit PEB offsets. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, MessageBox, ...): keep WinForms out of global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SessionKeeper.Tests" />
  </ItemGroup>

</Project>
